  "cards": [
    {
      "dot": "violet",
      "title": "Billing never imports ipd",
      "items": [
        "ipd already imports billing (bed-days, medicines), so the reverse import would be a cycle",
        "ipd registers stay_info_for as billing's stay provider at startup (ipd/handlers.py)",
        "billing asks stays_for(visit ids): one bulk lookup decides IPD vs OPD everywhere"
      ]
    },
    {
      "dot": "cyan",
      "title": "Who may do what",
      "items": [
        "Accountant and hospital admin: edit and finalise IPD bills, read all accounts",
        "Reception, cashier, billing staff, pharmacy: OPD bills only; refused on a stay",
        "The accountant takes no money: payment stays at the counter"
      ]
    },
    {
      "dot": "rose",
      "title": "Refused by the server",
      "items": [
        "Reception Paid on a stay: ipd_bill_by_accounts",
        "Cashier or billing staff editing a stay: 403 ipd_bill_accounts_only",
        "Save after someone else changed the stay: bill_changed, editor reloads",
        "Final bill while the patient is in a bed: stay_not_discharged"
      ]
    },
    {
      "dot": "amber",
      "title": "Decisions worth checking",
      "items": [
        "Outstanding counts issued bills only; a patient in a bed shows under Running in wards",
        "Total changes only on Save; the editor shows the last saved total",
        "Old bills reprint with the letterhead and logo version of their issue day"
      ]
    }
  ]
