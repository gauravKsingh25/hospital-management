# --- Secrets ---------------------------------------------------------------
# Every .env variant, at any depth (.env, .env.local, frontend/.env.local, …).
# Only the documented template is committed.
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.mypy_cache/
.dmypy.json
.ruff_cache/
.pytest_cache/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/

# --- Node / Next.js --------------------------------------------------------
node_modules/
.next/
out/
.turbo/
.vercel/
coverage/
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Playwright output. Traces and screenshots capture real screens — test data
# today, but the habit of committing them is the one that eventually commits a
# screenshot of a real patient.
/frontend/test-results/
/frontend/playwright-report/
/frontend/blob-report/
/frontend/.playwright/

# NOT ignored, and deliberately so: frontend/openapi.json and
# frontend/src/types/*.generated.* are generated but committed, because
# `npm run codegen:check` compares the tree against a fresh generation. That
# check is meaningless if the artefacts are not in the repository.

# --- Editors / OS ----------------------------------------------------------
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# --- Tooling ---------------------------------------------------------------
.claude/settings.local.json

# --- Local data ------------------------------------------------------------
# DB dumps and local databases may hold patient data; never commit them.
*.log
pgdata/
dump.rdb
*.sqlite
*.sqlite3
*.dump
*.sql.gz
