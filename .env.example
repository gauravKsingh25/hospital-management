# =============================================================================
# Hospital Patient-Journey Management System — environment template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Every variable the backend reads is documented here (CLAUDE.md §11).
# =============================================================================

# --- Application -----------------------------------------------------------
APP_NAME="Hospital Management API"
# local | development | staging | production
ENVIRONMENT=local
# Enables auto-reload, verbose errors and /docs. Must be false in production.
DEBUG=true
LOG_LEVEL=INFO
# JSON logs (production) vs human-readable console logs (local).
LOG_JSON=false
API_V1_PREFIX=/api/v1

# --- Database (Neon Postgres) ----------------------------------------------
# TWO connection strings are required (CLAUDE.md §5):
#
#   DATABASE_URL  -> POOLED endpoint (PgBouncer). Used by the API at runtime.
#                    Host contains "-pooler". Handles many short-lived
#                    connections; required because Neon free-tier compute
#                    auto-suspends and app connections churn.
#
#   DIRECT_URL    -> UNPOOLED endpoint (no "-pooler"). Used by Alembic only.
#                    Migrations need session-level features (advisory locks,
#                    DDL transactions) that a transaction-mode pooler breaks.
#
# Both may be written with the plain `postgresql://` scheme and Neon's
# `?sslmode=require&channel_binding=require` query string — the app rewrites
# them to `postgresql+asyncpg://` and applies TLS itself. Do not hand-edit the
# scheme.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# To use the local Postgres container from docker-compose instead of Neon:
#   DATABASE_URL="postgresql://hospital:hospital@postgres:5432/hospital"
#   DIRECT_URL="postgresql://hospital:hospital@postgres:5432/hospital"

# --- Database engine tuning ------------------------------------------------
# Echo every SQL statement to the log. Debugging only — very noisy.
DB_ECHO=false
# SQLAlchemy pool sits in front of PgBouncer: reuses TLS handshakes.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# Recycle below Neon's idle timeout so we never hand out a dead socket.
DB_POOL_RECYCLE_SECONDS=300
# Verifies a connection before use — essential with Neon auto-suspend.
DB_POOL_PRE_PING=true
# Generous: the first request after Neon suspends pays a cold-start (~1-3s).
DB_CONNECT_TIMEOUT_SECONDS=15
# Per-statement ceiling. 0 disables.
DB_COMMAND_TIMEOUT_SECONDS=30

# --- Redis (RBAC permission cache, and the ARQ worker's job queue) ---------
# Use the host-machine value here. docker-compose overrides it to
# `redis://redis:6379/0` for the containerised api service, so the same .env
# works whether you run uvicorn locally or via compose.
REDIS_URL="redis://localhost:6379/0"

# --- Background jobs (CLAUDE.md §6) ----------------------------------------
# The auto-close safety net: how long a visit may sit in a non-terminal state
# with nothing outstanding before the worker closes it, so a forgotten click
# does not leave encounters open forever.
#
# A rolling window rather than a wall-clock "end of day": a fixed hour needs a
# timezone, and a hospital's day does not end at midnight UTC. Raise it for an
# OPD that genuinely runs later than this.
ENCOUNTER_AUTO_CLOSE_HOURS=12
# How often the sweep runs, in minutes. Cheap — it scans one index.
WORKER_SWEEP_INTERVAL_MINUTES=60
# Master switch, so a deployment can run the API without the worker.
WORKER_SWEEPS_ENABLED=true

# --- Billing (CLAUDE.md §6, §7b) -------------------------------------------
# Whether an unpaid bill keeps a visit in PENDING_CLEARANCE. True matches
# CLAUDE.md §6, which names the cashier as a clearance station, and matches how
# a cash OPD runs: the patient settles before they leave.
#
# Turn it off for a hospital on corporate credit accounts, where patients
# legitimately walk out and finance invoices the employer next month. The
# balance still shows on the counter's screen either way — what changes is
# whether it holds the encounter open and lands on the auto-close sweep's
# "held for staff" list.
BILLING_BLOCKS_ENCOUNTER_CLOSURE=true

# --- Inpatient (CLAUDE.md §13 step 9) --------------------------------------
# How long after a dose was due before the sweep records it as MISSED, flagged
# `auto_missed`. Two hours is the usual ward tolerance: long enough that a busy
# drug round running late is not defamed as a missed dose, short enough that a
# genuinely missed antibiotic surfaces within the shift that missed it rather
# than at handover.
IPD_DOSE_GRACE_HOURS=2

# How far ahead the medication chart materialises its DUE slots. Deliberately
# short: a chart built weeks ahead is full of doses for orders that will be
# stopped tomorrow, and every one of them would age into a false "missed".
IPD_CHART_HORIZON_DAYS=2

# --- Reporting (CLAUDE.md §7b, §13 step 10) --------------------------------
# How long a patient may be waiting before their clinic is flagged as running
# late on reception's screen (§7b's doctor delay alert). Thirty minutes is the
# point at which people start coming to the desk to ask, so the alert should
# reach reception slightly before the patient does.
REPORTING_QUEUE_DELAY_MINUTES=30

# --- Notifications (CLAUDE.md §9, §13 step 8) ------------------------------
# Master switch. When false, every message is still recorded — as SUPPRESSED
# with reason DISABLED — rather than skipped silently. A hospital that turned
# messaging off six months ago should be able to discover that is why nobody is
# being reminded of anything, instead of staring at an empty outbox.
NOTIFICATIONS_ENABLED=true

# Which provider adapter delivers. `console` logs the rendered message and
# reports success (the default: no third-party account, no cost, and the whole
# pipeline is still exercised end to end). `null` accepts silently.
# A real WhatsApp/SMS adapter registers itself in notifications/gateways.py and
# is named here — that integration needs a Meta WABA account with approved
# templates, and Indian SMS additionally needs DLT registration.
NOTIFICATION_GATEWAY=console

# The fallback ladder (CLAUDE.md §9: WhatsApp -> SMS -> email). Ordered,
# comma-separated. Configurable because the right order is a fact about a
# hospital's patients, not about the software. Channels the recipient has no
# address for are skipped rather than attempted and failed.
NOTIFICATION_CHANNEL_PRIORITY="WHATSAPP,SMS,EMAIL"

# How many times the whole ladder may be walked before a message is written off.
# One walk already tries every channel, so this covers transient provider
# outages, not bad numbers. After this, somebody has to pick up a phone.
NOTIFICATION_MAX_ATTEMPTS=3

# The retry sweep, run by the worker alongside the encounter auto-close. Its own
# switch so a deployment can keep the clinical safety net running while a
# provider incident is in progress.
NOTIFICATION_RETRY_ENABLED=true
NOTIFICATION_RETRY_BATCH_SIZE=100

# --- Authentication (CLAUDE.md §12) ----------------------------------------
# JWT signing key. Generate a fresh one per environment:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Rotating it invalidates every outstanding token — the emergency lever.
# The app refuses to start in production if this is shorter than 32 chars.
SECRET_KEY="CHANGE-ME-generate-with-secrets.token_urlsafe(64)"
JWT_ALGORITHM=HS256
JWT_ISSUER=hospital-management
# Short access token: a leaked one expires before it is useful.
ACCESS_TOKEN_TTL_MINUTES=15
# Refresh tokens rotate on every use; reuse revokes the whole family.
REFRESH_TOKEN_TTL_DAYS=7
# Length-first policy (NIST SP 800-63B) — no composition rules.
PASSWORD_MIN_LENGTH=12
# Argon2id work factors. Raise ARGON2_MEMORY_KIB before ARGON2_TIME_COST.
ARGON2_TIME_COST=2
ARGON2_MEMORY_KIB=65536
ARGON2_PARALLELISM=2

# --- Testing ---------------------------------------------------------------
# Integration tests run against this LOCAL database and never against
# DATABASE_URL — an accidental DROP on a shared Neon branch should not be a
# mistake anyone is able to make. `docker compose up postgres` provides it.
TEST_DATABASE_URL="postgresql://hospital:hospital@localhost:5432/hospital_test"

# --- CORS (frontend origins) -----------------------------------------------
# Comma-separated. The Next.js dev server runs on :3000.
#
# Worth knowing how little this actually does here. The browser never calls
# this API directly — it calls the Next.js app, which proxies server-side (see
# frontend/src/app/bff). Server-to-server requests are not subject to CORS at
# all, so these origins matter only for the OpenAPI docs page and for any
# future client that does talk to the API directly.
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# =============================================================================
# Frontend (Next.js) — read by the web container and by `npm run dev`
# =============================================================================

# Where the frontend's server-side code reaches FastAPI. SERVER-SIDE ONLY:
# it is never sent to the browser, and `src/lib/env.ts` is marked
# `server-only` so importing it into a client component fails the build rather
# than leaking this into a bundle.
#
# docker-compose overrides this to http://api:8000/api/v1 for the web service.
API_BASE_URL="http://127.0.0.1:8000/api/v1"

# How long the frontend waits on the backend before giving up.
#
# Deliberately generous, and not a latency budget. A timeout part-way through
# a registration still creates the patient, while the counter sees an error
# and re-registers them — a duplicate UHID, which is a split medical history.
# Better to wait than to duplicate. If requests routinely approach this, the
# problem is the database's distance (see the README on Neon regions), not
# this number.
API_TIMEOUT_MS=45000

# Host port for the web container.
WEB_PORT=3000

# --- End-to-end tests ------------------------------------------------------
# Credentials created by `backend/scripts/seed_demo.py`, which the Playwright
# suite signs in with. Development and test environments only.
DEMO_PASSWORD="demo-password-2026"

# Where Playwright points. Override to test a deployed environment.
E2E_BASE_URL="http://localhost:3000"

# The CLAUDE.md §7b registration gate, in seconds, as asserted by the e2e
# suite. Raise it ONLY to keep a deliberately distant test environment green —
# never to make a genuinely slow workflow pass.
E2E_REGISTRATION_BUDGET_SECONDS=30

# --- Local Postgres container credentials (docker-compose only) ------------
# Ignored when DATABASE_URL points at Neon.
POSTGRES_USER=hospital
POSTGRES_PASSWORD=hospital
POSTGRES_DB=hospital
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000
